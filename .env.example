# Configuration de la base de données
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cleaner"
DATABASE_URL="postgresql://postgres:banembguilanga2003@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require"
# Environnement
NODE_ENV=development

# Configuration JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRATION="21d"

# Configuration Google OAuth2
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Configuration SMTP pour OTP (Gmail)
# IMPORTANT: Pour Gmail, utiliser un "App Password" et non votre mot de passe habituel
# 1. Allez dans: https://myaccount.google.com/security
# 2. Activez "Validation en deux étapes"
# 3. Générez un "Mot de passe d'application"
# 4. Utilisez ce mot de passe d'application dans MAIL_PASSWORD
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USERNAME="michaeltchamou393@gmail.com"
MAIL_PASSWORD="szhmdwnzyfmowkff"
MAIL_ENCRYPTION="tls"
MAIL_FROM_ADDRESS="noreply@cleaner.cm"
MAIL_FROM_NAME="Cleaner App"

# Configuration Frontend
FRONTEND_URL="http://localhost:3001"

# Port du serveur
PORT=3000

# Configuration Vercel Blob (pour le stockage d'images)
# Obtenez ce token depuis: Vercel Dashboard > Project > Settings > Environment Variables
# Cliquez sur "Add New" et sélectionnez "Blob Storage" pour générer le token
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your-token-here"

# Configuration OneSignal
# IMPORTANT: Utilisez votre vraie REST API Key depuis OneSignal Dashboard
# La clé doit être une REST API Key, pas une App Key
ONESIGNAL_APP_ID="e8693c4c-fb87-4960-be83-12285324163c"

# POUR RECEVOIR DE VRAIES NOTIFICATIONS:
# 1. Allez sur https://app.onesignal.com/
# 2. Créez une application ou utilisez une existante
# 3. Allez dans Settings → Keys & IDs
# 4. Copiez la REST API Key (format court, ex: NzU4M2YtYjM4Yy00NGY5LWE5M2MtZjY1Yzg2MmU3YmQ2)
# 5. Remplacez la ligne ci-dessous par votre vraie clé

ONESIGNAL_API_KEY="os_v2_app_5butyth3q5ewbpudciufgjawhqwncc2tm62u7mm53ckvr3gex55aozzrbu2yihwjg2ulntsffrv2efb7ci5rk22hjs4ketz3llhjcri"
