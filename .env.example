# Configuration de la base de données
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cleaner"
DATABASE_URL="postgresql://postgres:banembguilanga2003@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require"
# Environnement
