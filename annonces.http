### ÉTAPE 1: Créer une annonce SANS fichiers (test simple)
POST {{baseUrl}}/annonces
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "type": "PERDU",
  "titre": "Carte nationale d'identité perdue",
  "description": "CNI perdue près du marché central de Douala, portant le nom de Jean Dupont",
  "nom_proprietaire": "Jean Dupont",
  "lieu": "Douala, Marché Central",
  "auteur_id": "df06aaf9-cde4-4c2f-af26-daf4fa5adeef",
  "date_perte_ou_decouverte": "2026-05-10T10:00:00.000Z",
  "recompense": 50000,
  "documents": [
    {
      "categories": ["CNI"],
      "reference": "CNI-2024-123456",
      "photos_urls": [
        "https://example.com/cni-front.jpg"
      ],
      "est_lisible": true
    }
  ]
}

