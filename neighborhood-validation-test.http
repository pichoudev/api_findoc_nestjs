### Test de mise à jour avec quartier existant
@baseUrl = http://localhost:3000/api/v1
@contentType = application/json

### 1. Lister les quartiers disponibles
GET {{baseUrl}}/neighborhoods
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJlNDg3YjVjYy0xZGY0LTQ2NTAtYTFmNy1hNzk5ODU5YmUyMjEiLCJlbWFpbCI6Imxvb25hNzc1N0BnbWFpbC5jb20iLCJwaG9uZSI6IisyMzc2OTg3NjU0MzIiLCJyb2xlIjoiQ0lUSVpFTiIsImlhdCI6MTc3NTIwNzAxMSwiZXhwIjoxNzc3MDIxNDExfQ.fjOZ2Cdo4lRbthg22GRJyjoGp5fSZ738nbXM6Gg-Nr0

### 2. Test avec quartier existant (remplacez "NOM_DU_QUARTIER" par un nom réel)
PATCH {{baseUrl}}/users/profile
Content-Type: {{contentType}}
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJlNDg3YjVjYy0xZGY0LTQ2NTAtYTFmNy1hNzk5ODU5YmUyMjEiLCJlbWFpbCI6Imxvb25hNzc1N0BnbWFpbC5jb20iLCJwaG9uZSI6IisyMzc2OTg3NjU0MzIiLCJyb2xlIjoiQ0lUSVpFTiIsImlhdCI6MTc3NTIwNzAxMSwiZXhwIjoxNzc3MDIxNDExfQ.fjOZ2Cdo4lRbthg22GRJyjoGp5fSZ738nbXM6Gg-Nr0

{
  "firstName": "loona",
  "lastName": "Dupont",
  "phone": "+237698765432",
  "neighborhood": "NOM_DU_QUARTIER"
}

### 3. Vérification du profil après mise à jour
GET {{baseUrl}}/users/profile
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJlNDg3YjVjYy0xZGY0LTQ2NTAtYTFmNy1hNzk5ODU5YmUyMjEiLCJlbWFpbCI6Imxvb25hNzc1N0BnbWFpbC5jb20iLCJwaG9uZSI6IisyMzc2OTg3NjU0MzIiLCJyb2xlIjoiQ0lUSVpFTiIsImlhdCI6MTc3NTIwNzAxMSwiZXhwIjoxNzc3MDIxNDExfQ.fjOZ2Cdo4lRbthg22GRJyjoGp5fSZ738nbXM6Gg-Nr0
