### Test de mise à jour du profil avec quartier
@baseUrl = https://backend-cleaner-nestjs.onrender.com/api/v1
@contentType = application/json

### 1. Connexion pour obtenir le token
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "loona7757@gmail.com",
  "password": "Password123"
}

### 2. Test mise à jour profil avec quartier existant (par nom)
PATCH {{baseUrl}}/users/profile
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJlNDg3YjVjYy0xZGY0LTQ2NTAtYTFmNy1hNzk5ODU5YmUyMjEiLCJlbWFpbCI6Imxvb25hNzc1N0BnbWFpbC5jb20iLCJwaG9uZSI6IisyMzc2OTg3NjU0MzIiLCJyb2xlIjoiQ0lUSVpFTiIsImlhdCI6MTc3NTE5ODM1NywiZXhwIjoxNzc3MDEyNzU3fQ.TEt5N7KM-TA6Ny5dFFYin_fUdFKsSRAIaZSlLdqflxA
Content-Type: {{contentType}}

{
  "firstName": "Loona",
  "lastName": "Test",
  "neighborhood": "Bonaberi"
}

