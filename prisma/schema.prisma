generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, uuid_ossp(map: "uuid-ossp", schema: "extensions")]
}

// ─── ENUMS ───────────────────────────────────────────

enum Type_annonce {
  PERDU
  TROUVE
}

enum Statut_annonce {
  ARCHIVE
  EN_COURS
  RENDU
}

enum Type_notification {
  CORRESPONDANCE
  CONTACT_REVELE
  SIGNALEMENT
  SYSTEME
}

enum Type_utilisateur {
  UTILISATEUR
  ADMIN
}

enum Categorie_Document {
  CNI
  PASSPORT
  PERMIS
  DIPLOME
  CARTE_BANCAIRE
  AUTRE
}

enum Mode_paiement {
  OM
  MOMO
  VIREMENT_BANCAIRE
}

enum Region {
  LITTORALE
  CENTRE
}

// ─── MODÈLES ─────────────────────────────────────────

model Utilisateur {
  id               String           @id @default(uuid())
  prenom           String
  nom              String
  email            String           @unique
  telephone        String?
  mot_de_passe_hash String
  role             Type_utilisateur @default(UTILISATEUR)
  photo            String?
  one_signal_id    String?          @map("oneSignalId")
  token            String?
  ville            String?
  region           Region?
  refresh_token    String?
  est_verifie      Boolean          @default(false)
  est_actif        Boolean          @default(false)
  cree_le          DateTime         @default(now())
  mis_a_jour_le    DateTime         @updatedAt

  // Relations
  annonces         Annonce[]
  alerts           Alert[]
  notifications    Notification[]
  releves_contact  Releve_contact[]
  paiements        paiement[]

  @@map("utilisateurs")
}

model Annonce {
  id                     String         @id @default(uuid())
  auteur_id              String
  type                   Type_annonce
  date_de_naissance      DateTime?      @db.Date
  nom_proprietaire       String
  statut                 Statut_annonce @default(EN_COURS)
  titre                  String
  recompense             Float?
  description            String
  lieu                   String
  date_perte_ou_decouverte DateTime
  cree_le                DateTime       @default(now())
  mis_a_jour_le          DateTime       @updatedAt

  // Relations
  auteur          Utilisateur      @relation(fields: [auteur_id], references: [id])
  documents       Document[]
  alerts          Alert[]
  releves_contact Releve_contact[]
  paiements       paiement[]

  @@map("annonces")
}

model Document {
  id          String               @id @default(uuid())
  annonce_id  String
  categories  Categorie_Document[]
  reference   String?
  photos_urls String[]
  est_lisible Boolean              @default(true)
  mis_a_jour_le DateTime           @updatedAt

  // Relations
  annonce     Annonce @relation(fields: [annonce_id], references: [id], onDelete: Cascade)

  @@map("documents")
}

model Alert {
  id         String   @id @default(uuid())
  auteur_id  String
  annonce_id String
  motif      String
  statut     String   @default("EN_ATTENTE")
  cree_le    DateTime @default(now())

  // Relations
  auteur  Utilisateur @relation(fields: [auteur_id], references: [id])
  annonce Annonce     @relation(fields: [annonce_id], references: [id], onDelete: Cascade)

  @@map("alerts")
}

model Notification {
  id             String            @id @default(uuid())
  utilisateur_id String
  type           Type_notification
  message        String
  est_lue        Boolean           @default(false)
  envoyee_le     DateTime          @default(now())

  // Relations
  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Releve_contact {
  id             String        @id @default(uuid())
  utilisateur_id String
  annonce_id     String
  est_paye       Boolean       @default(false)
  mode_paiement  Mode_paiement?
  montant        Float
  revele_le      DateTime      @default(now())

  // Relations
  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [id])
  annonce     Annonce     @relation(fields: [annonce_id], references: [id], onDelete: Cascade)

  @@map("releves_contact")
}

model Ville {
  id      String   @id @default(uuid())
  nom     String
  region  Region
  cree_le DateTime @default(now())

  @@map("villes")
}

model paiement {
  id            String        @id @default(uuid())
  montant       Float
  auteur_id     String
  annonce_id    String
  mode_paiement Mode_paiement
  statut        String
  email         String?  
  phone         String?  
  first_name    String?  
  last_name     String? 
  reference    String?  @unique
  notchpay_url String? 
  cree_le       DateTime      @default(now())

  // Relations
  auteur  Utilisateur @relation(fields: [auteur_id], references: [id], onDelete: Cascade)
  annonce Annonce @relation(fields: [annonce_id], references: [id], onDelete: Cascade)

  @@map("paiements")
}