### Tests pour le profil utilisateur
@baseUrl = http://localhost:3000/api/v1
@contentType = application/json

### 1. Obtenir le profil de l'utilisateur connecté
GET {{baseUrl}}/users/profile
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJlNDg3YjVjYy0xZGY0LTQ2NTAtYTFmNy1hNzk5ODU5YmUyMjEiLCJlbWFpbCI6Imxvb25hNzc1N0BnbWFpbC5jb20iLCJwaG9uZSI6IisyMzc2OTg3NjU0MzIiLCJyb2xlIjoiQ0lUSVpFTiIsImlhdCI6MTc3NTIwNzAxMSwiZXhwIjoxNzc3MDIxNDExfQ.fjOZ2Cdo4lRbthg22GRJyjoGp5fSZ738nbXM6Gg-Nr0
### 2. Mettre à jour le profil de l'utilisateur connecté
PATCH {{baseUrl}}/users/profile
Content-Type: {{contentType}}
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJlNDg3YjVjYy0xZGY0LTQ2NTAtYTFmNy1hNzk5ODU5YmUyMjEiLCJlbWFpbCI6Imxvb25hNzc1N0BnbWFpbC5jb20iLCJwaG9uZSI6IisyMzc2OTg3NjU0MzIiLCJyb2xlIjoiQ0lUSVpFTiIsImlhdCI6MTc3NTM1OTQyMiwiZXhwIjoxNzc3MTczODIyfQ.I6menPXTPiUWOdG3VCo2c_xx7WAdegw8VUiRDeUZkKo

{
  "firstName": "loona",
  "lastName": "Dupont",
  "phone": "+237698765432",
  "neighborhood": "Ndogbong"
}

### 3. Mettre à jour uniquement le prénom
PATCH {{baseUrl}}/users/profile
Content-Type: {{contentType}}
Authorization: Bearer votre_token_jwt_ici

{
  "firstName": "Marie"
}

### 4. Mettre à jour l'email (vérification du conflit)
PATCH {{baseUrl}}/users/profile
Content-Type: {{contentType}}
Authorization: Bearer votre_token_jwt_ici

{
  "email": "nouveau.email@example.com"
}

### 5. Mettre à jour le quartier
PATCH {{baseUrl}}/users/profile
Content-Type: {{contentType}}
Authorization: Bearer votre_token_jwt_ici

{
  "neighborhoodId": "uuid-nouveau-quartier"
}

### 6. Mettre à jour plusieurs champs
PATCH {{baseUrl}}/users/profile
Content-Type: {{contentType}}
Authorization: Bearer votre_token_jwt_ici

{
  "firstName": "Pierre",
  "lastName": "Martin",
  "email": "pierre.martin@example.com",
  "phone": "+237612345678",
  "neighborhoodId": "uuid-quartier-bonaberi"
}

### 7. Tentative de mise à jour sans authentification (doit échouer)
PATCH {{baseUrl}}/users/profile
Content-Type: {{contentType}}

{
  "firstName": "Non authentifié"
}

### 8. Tentative de mise à jour avec un email déjà utilisé (doit échouer)
PATCH {{baseUrl}}/users/profile
Content-Type: {{contentType}}
Authorization: Bearer votre_token_jwt_ici

{
  "email": "email.deja.utilise@example.com"
}

### 9. Tentative de mise à jour avec un téléphone déjà utilisé (doit échouer)
PATCH {{baseUrl}}/users/profile
Content-Type: {{contentType}}
Authorization: Bearer votre_token_jwt_ici

{
  "phone": "+237698765433"
}

### 10. Mettre à jour avec un quartier inexistant (doit échouer)
PATCH {{baseUrl}}/users/profile
Content-Type: {{contentType}}
Authorization: Bearer votre_token_jwt_ici

{
  "neighborhoodId": "uuid-quartier-inexistant"
}

### ========================================
### EXEMPLES D'UTILISATION
### ========================================

### Exemple 1: Mise à jour complète du profil
# 1. D'abord obtenir le profil actuel
GET {{baseUrl}}/users/profile
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJlNDg3YjVjYy0xZGY0LTQ2NTAtYTFmNy1hNzk5ODU5YmUyMjEiLCJlbWFpbCI6Imxvb25hNzc1N0BnbWFpbC5jb20iLCJwaG9uZSI6IisyMzc2OTg3NjU0MzIiLCJyb2xlIjoiQ0lUSVpFTiIsImlhdCI6MTc3NTE1MjAzMiwiZXhwIjoxNzc2OTY2NDMyfQ.GYvjivWe67Uv7KnRZXSMFDQXxQO2dec5g-orlew0FGo

### Exemple 2: Mise à jour partielle
PATCH {{baseUrl}}/users/profile
Content-Type: {{contentType}}
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJlNDg3YjVjYy0xZGY0LTQ2NTAtYTFmNy1hNzk5ODU5YmUyMjEiLCJlbWFpbCI6Imxvb25hNzc1N0BnbWFpbC5jb20iLCJwaG9uZSI6IisyMzc2OTg3NjU0MzIiLCJyb2xlIjoiQ0lUSVpFTiIsImlhdCI6MTc3NTE1MjAzMiwiZXhwIjoxNzc2OTY2NDMyfQ.GYvjivWe67Uv7KnRZXSMFDQXxQO2dec5g-orlew0FGo

{
  "firstName": "Alice",
  "lastName": "Ngono"
}

### ========================================
### RÉPONSES ATTENDUES
### ========================================

### Succès (200 OK)
{
  "id": "uuid-utilisateur",
  "firstName": "Jean",
  "lastName": "Dupont",
  "email": "jean.dupont@example.com",
  "phone": "+237698765432",
  "role": "CITIZEN",
  "isActive": true,
  "neighborhoodId": "uuid-du-quartier",
  "neighborhood": {
    "id": "uuid-du-quartier",
    "name": "Bonaberi",
    "city": {
      "id": "uuid-ville",
      "name": "Douala",
      "region": "LITTORAL"
    }
  },
  "createdAt": "2026-04-02T20:00:00.000Z",
  "updatedAt": "2026-04-02T20:30:00.000Z"
}

### Erreur (401 Unauthorized)
{
  "message": "Utilisateur non authentifié",
  "error": "Unauthorized",
  "statusCode": 401
}

### Erreur (409 Conflict)
{
  "message": "Cet email est déjà utilisé",
  "error": "Conflict",
  "statusCode": 409
}

### Erreur (400 Bad Request)
{
  "message": "Le quartier spécifié n'existe pas",
  "error": "Bad Request",
  "statusCode": 400
}
