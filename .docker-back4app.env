# ========================================
# .docker-back4app.env - Variables d'environnement Back4App
# ========================================
# Configuration spécifique pour le déploiement sur Back4App
# ========================================

# Configuration de l'application
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Configuration de la base de données (Back4App PostgreSQL)
DATABASE_URL=postgresql://username:password@host:5432/database_name

# Configuration JWT (UTILISEZ LA CLÉ GÉNÉRÉE PRÉCÉDEMMENT)
JWT_SECRET=5f5c75b4467488bbedf041cf7d130984791bdeb1330e2bdc324ac890940172f1ef978ebd751c5bccbad7c6792e49b04d4de3d66d850e47fd371c2535dc7537fc
JWT_EXPIRATION=21d

# Configuration Redis (Back4App Redis)
REDIS_URL=redis://username:password@host:6379

# Configuration CORS (Back4App)
FRONTEND_URL=https://your-app.back4app.io
CORS_ORIGIN=https://your-app.back4app.io

# Configuration Email (Back4App ou service externe)
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@yourapp.com

# Configuration SMS (Back4App ou service externe)
SMS_SERVICE=twilio
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# Configuration File Storage (Back4App Files)
FILE_STORAGE=back4app
BACK4APP_FILES_URL=https://parseapi.back4app.com/files

# Configuration Monitoring
LOG_LEVEL=info
ENABLE_METRICS=true

# Configuration Sécurité
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Configuration Performance
ENABLE_COMPRESSION=true
ENABLE_CACHE=true
CACHE_TTL=3600

# ========================================
# Instructions pour Back4App
# ========================================
# 1. Copiez ce fichier en .env dans les variables d'environnement Back4App
# 2. Remplacez les valeurs par vos vraies clés d'API
# 3. Configurez les URLs de votre application Back4App
# 4. Testez la connexion à la base de données et Redis
# ========================================
