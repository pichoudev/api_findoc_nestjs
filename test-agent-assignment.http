### Test de notification d'assignation d'intervention à un agent

@baseUrl = http://localhost:3000/api/v1
@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJlNDg3YjVjYy0xZGY0LTQ2NTAtYTFmNy1hNzk5ODU5YmUyMjEiLCJlbWFpbCI6Imxvb25hNzc1N0BnbWFpbC5jb20iLCJwaG9uZSI6IisyMjc2OTg3NjU0MzIiLCJyb2xlIjoiQURNSU4iLCJpYXQiOjE3Nzc0Nzg3MTAsImV4cCI6MTc3OTI5MzExMH0.orNbodFWVQxl-_wmy-8oe8B4OHQ9J6U6Nyhwotc82GQ
@agentId = AGENT_ID_HERE
@reportId = REPORT_ID_HERE

### 1. Lister les signalements sans intervention
GET {{baseUrl}}/reports?status=RECU
Authorization: Bearer {{token}}

### 2. Assigner une intervention à un agent - Doit envoyer INTERVENTION_ASSIGNED
POST {{baseUrl}}/interventions
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "reportId": "{{reportId}}",
  "agentId": "{{agentId}}",
  "comment": "Intervention assignée pour test de notification"
}

### 3. Vérifier les notifications de l'agent après assignation
GET {{baseUrl}}/notifications/user/{{agentId}}
Authorization: Bearer {{token}}

### 4. Vérifier si l'agent a un App ID OneSignal
GET {{baseUrl}}/notifications/user/{{agentId}}/has-onesignal
Authorization: Bearer {{token}}

### 5. Lister les interventions pour vérifier la création
GET {{baseUrl}}/interventions
Authorization: Bearer {{token}}

### 6. Test direct de notification INTERVENTION_ASSIGNED
POST {{baseUrl}}/notifications/test
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "userId": "{{agentId}}",
  "event": "INTERVENTION_ASSIGNED",
  "data": {
    "interventionId": "test_intervention_123",
    "referenceCode": "REP-001",
    "agentId": "{{agentId}}",
    "reportId": "{{reportId}}",
    "reporterId": "reporter_user_id"
  }
}

### 7. Compter les notifications non lues de l'agent
GET {{baseUrl}}/notifications/user/{{agentId}}/unread-count
Authorization: Bearer {{token}}

### 8. Marquer les notifications de l'agent comme lues
PATCH {{baseUrl}}/notifications/mark-all-read
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "userId": "{{agentId}}"
}

### 9. Lister tous les agents disponibles
GET {{baseUrl}}/users?role=AGENT
Authorization: Bearer {{token}}

### 10. Vérifier le statut du signalement après assignation
GET {{baseUrl}}/reports/{{reportId}}
Authorization: Bearer {{token}}
