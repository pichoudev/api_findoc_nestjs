### ==================== INTERVENTIONS ====================

### 40. Lister toutes les interventions
GET {{baseUrl}}/interventions
Authorization: Bearer VOTRE_TOKEN_ADMIN_ICI

### 41. Lister les interventions avec filtres
GET {{baseUrl}}/interventions?status=EN_COURS&agentId=uuid-de-l-agent&page=1&limit=20
Authorization: Bearer VOTRE_TOKEN_ADMIN_ICI

### 42. Obtenir une intervention spécifique
GET {{baseUrl}}/interventions/uuid-de-l-intervention
Authorization: Bearer VOTRE_TOKEN_ADMIN_ICI

### 43. Créer une intervention
POST {{baseUrl}}/interventions
Content-Type: {{contentType}}
Authorization: Bearer VOTRE_TOKEN_ADMIN_ICI

{
  "reportId": "uuid-du-signalement",
  "agentId": "uuid-de-l-agent",
  "type": "COLLECTION",
  "status": "PLANIFIEE",
  "scheduledAt": "2026-04-05T15:00:00Z",
  "estimatedDuration": 60,
  "priority": "HIGH",
  "description": "Intervention planifiée pour vider le bac signalé",
  "equipment": ["Camion benne", "Gants", "Sacs poubelle"],
  "notes": "Intervention urgente suite à signalement citoyen"
}

### 44. Mettre à jour une intervention
PATCH {{baseUrl}}/interventions/uuid-de-l-intervention
Content-Type: {{contentType}}
Authorization: Bearer VOTRE_TOKEN_ADMIN_ICI

{
  "status": "EN_COURS",
  "startedAt": "2026-04-05T15:05:00Z",
  "notes": "Intervention commencée, en route vers le site"
}

### 45. Démarrer une intervention
PATCH {{baseUrl}}/interventions/uuid-de-l-intervention/start
Content-Type: {{contentType}}
Authorization: Bearer VOTRE_TOKEN_ADMIN_ICI

{
  "startedAt": "2026-04-05T15:05:00Z",
  "notes": "Début de l'intervention sur site",
  "equipmentUsed": ["Camion benne", "Gants"]
}

### 46. Terminer une intervention
PATCH {{baseUrl}}/interventions/uuid-de-l-intervention/complete
Content-Type: {{contentType}}
Authorization: Bearer VOTRE_TOKEN_ADMIN_ICI

{
  "completedAt": "2026-04-05T16:15:00Z",
  "duration": 70,
  "result": "SUCCESS",
  "notes": "Intervention terminée avec succès, bac vidé et zone nettoyée",
  "beforeImages": ["url-image-avant"],
  "afterImages": ["url-image-apres"],
  "wasteCollected": 85,
  "fuelUsed": 5.2
}

### 47. Annuler une intervention
PATCH {{baseUrl}}/interventions/uuid-de-l-intervention/cancel
Content-Type: {{contentType}}
Authorization: Bearer VOTRE_TOKEN_ADMIN_ICI

{
  "reason": "Intervention non nécessaire - bac déjà vidé",
  "cancelledAt": "2026-04-05T14:30:00Z"
}

### 48. Réassigner une intervention
PATCH {{baseUrl}}/interventions/uuid-de-l-intervention/reassign
Content-Type: {{contentType}}
Authorization: Bearer VOTRE_TOKEN_ADMIN_ICI

{
  "newAgentId": "uuid-nouvel-agent",
  "reason": "Agent précédent indisponible",
  "notes": "Réassignation à un autre agent disponible"
}

